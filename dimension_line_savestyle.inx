<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Dimension Line: Save Style</name>
    <id>org.markus.architecture.dimension_line_savestyle</id>

    <param name="save" type="bool" gui-hidden="true">true</param>
    <label xml:space="preserve">Select one existing dimension and run this to store its
style as the saved default. New dimensions then use it
(Dimension Line dialog, "Use the saved style").

The style is kept in dimension_line_style.json next to
the extension.</label>

    <effect>
        <object-type>all</object-type>
        <effects-menu>
            <submenu name="Architecture"/>
        </effects-menu>
    </effect>

    <script>
        <command location="inx" interpreter="python">dimension_line.py</command>
    </script>
</inkscape-extension>
